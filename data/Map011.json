{"id":1,"name":"惠仁相遇事件","note":"","pages":[{"conditions":{"actorId":0,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":230,"indent":0,"parameters":[200]},{"code":241,"indent":0,"parameters":[{"name":"轻快喜悦","volume":15,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["穿过春日的校园，踱步至教学楼门口，耳畔忽地传来熟悉的声音将"]},{"code":401,"indent":0,"parameters":["自己喊住。"]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"？？？"]},{"code":401,"indent":0,"parameters":["欧尼~早安！"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那声音乘着带有馥郁花香的微风，最终降落在你心间，因为过于"]},{"code":401,"indent":0,"parameters":["悦耳，就连准备迎接第一节课测验而迈起的沉重步伐都轻松了几分。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你连忙转身笑着回应她，让那高挑的身影闯入你的视野。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她两步便靠了过来，嫌方才的招呼并不充分，又自然地挽住你的"]},{"code":401,"indent":0,"parameters":["手臂。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["今天来得有些晚啊？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["因为天天相见又对彼此的日程过于了解，寒暄的话题总是可以随口"]},{"code":401,"indent":0,"parameters":["就来。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":234,"indent":0,"parameters":[2,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["在外面买了早餐，今天想换换口味。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[4,"$Hyein撒娇~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[4,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["哎——那你不去食堂啦？我还没吃早餐呢……"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["无论多少次看她犀利的眉眼做出一副撒娇的可怜样都会轻声笑出来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["作为全校最高的女生，与朋友相处起来却总是更偏好撒娇的的模式。"]},{"code":234,"indent":0,"parameters":[4,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["怎么会，我拿到食堂陪你。再说了，光吃这些多噎啊？得就着学校的"]},{"code":401,"indent":0,"parameters":["免费豆浆吃！"]},{"code":232,"indent":0,"parameters":[4,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[4]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["人们或许允许习惯因心血来潮而改变，却很少有人能彻底舍弃某种"]},{"code":401,"indent":0,"parameters":["让自己感到安心的行为，这是一种本能。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["李惠仁听到令自己满意的回复，眼尾勾成了弯弯的月亮，轻轻地欢呼"]},{"code":401,"indent":0,"parameters":["了一声。"]},{"code":234,"indent":0,"parameters":[1,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["我去教室把书包放下，还得先陪你去买草莓牛奶，对吧？"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["草莓牛奶~"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的回复是调皮地重复与模仿。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["讨人喜欢的孩子气性格。"]},{"code":234,"indent":0,"parameters":[3,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["你是不是可以…不用喝牛奶了？再这样下去，下次体检要长到一米八"]},{"code":401,"indent":0,"parameters":["了吧？"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[5,"$Hyein惊讶~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[5,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["草莓牛奶不是牛奶，是饮料！！！"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["欢呼转为不可置信的惊呼，两人的身影向教室离去……"]},{"code":232,"indent":0,"parameters":[5,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[5]},{"code":123,"indent":0,"parameters":["A",0]},{"code":242,"indent":0,"parameters":[3]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":1,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,3,0,0,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
