{"id":1,"name":"胸针","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":241,"indent":0,"parameters":[{"name":"谈心","volume":30,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你和惠仁一起把餐垫铺好，取出两人各自的午餐，开始了今天的花园"]},{"code":401,"indent":0,"parameters":["野餐。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她从餐盒中取出勺子，却没有挖向摆放整齐的饭菜，而是像递麦克风"]},{"code":401,"indent":0,"parameters":["一样把勺子送到你的嘴边。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["咳咳，提问！春天为我们送来了什么？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你一时没跟上这孩子的思路，正拆着三明治包装的手也停了下来，"]},{"code":401,"indent":0,"parameters":["歪头疑惑地看着她。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["尝试着按照自己的思维回答了几个词，却都被惠仁摇摇头否定了。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[14,"梨花的礼物~1",0,0,0,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[14,0,0,0,0,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁一边挂上一副得逞的笑容，一边从自己的背包里取出一个包装"]},{"code":401,"indent":0,"parameters":["精美的小盒子。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["盒子外的包装纸是薰衣草的浅紫色，丝带则搭配以淡蓝色的底子与"]},{"code":401,"indent":0,"parameters":["白色的草莓斑点，在盒子的顶端打了个饱满漂亮的蝴蝶结。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["看到惠仁精心准备的礼物，你更加困惑了。你在脑中搜寻了半天今天"]},{"code":401,"indent":0,"parameters":["是什么重要的日子、或是即将有什么值得庆祝的日子临近，最终一无"]},{"code":401,"indent":0,"parameters":["所获。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这个答案只能等惠仁亲自为你解答。当然，在你的不解中，更多"]},{"code":401,"indent":0,"parameters":["一部分的情绪依然是对这份礼物的惊喜与感动。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["在思绪和行动都因这份突然的礼物僵住的同时，惠仁捉了你的手"]},{"code":401,"indent":0,"parameters":["抬起来，结结实实地把那个小礼盒塞进你的掌心，又推着你的手"]},{"code":401,"indent":0,"parameters":["将它送回你怀里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你抬头再次向惠仁寻求许可，惠仁回应你的目光充满了期待与肯定。"]},{"code":232,"indent":0,"parameters":[14,0,0,0,0,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[14]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["小心翼翼地拽着丝带的边缘将整齐的蝴蝶结拆散，藏在丝带下面的"]},{"code":401,"indent":0,"parameters":["方形贺卡露了出来。"]},{"code":231,"indent":0,"parameters":[19,"胸针与贺卡~1",0,0,160,56,50,50,0,0]},{"code":232,"indent":0,"parameters":[19,0,0,0,160,56,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁在上面写了字，小巧娟秀的字体写着“给惠仁最珍惜的姐姐”，"]},{"code":401,"indent":0,"parameters":["然后是几行小字，惠仁习惯在纸面上进行一些碎碎念。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["若是全班人的试卷混在一起，她的笔迹也能被你一眼认出来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["围绕着文字的周边，是先用彩笔勾的一些装饰性线条和各种可爱的"]},{"code":401,"indent":0,"parameters":["图案，从颜色搭配和一笔一画的勾勒中能够看出，当时的惠仁十分"]},{"code":401,"indent":0,"parameters":["用心。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这张贺卡散发出淡淡的纸本香气和晚香玉的味道，后者是惠仁最近"]},{"code":401,"indent":0,"parameters":["在书桌做手工时偏爱点燃的香薰味道。小小的一张卡片，浸染上了"]},{"code":401,"indent":0,"parameters":["她家里的气味。"]},{"code":232,"indent":0,"parameters":[19,0,0,0,160,56,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[19]},{"code":231,"indent":0,"parameters":[11,"$Hyein害羞直视~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["不知是不是因为将它放到鼻底嗅问的动作像是亲吻，惠仁腼腆地冲你"]},{"code":401,"indent":0,"parameters":["笑了笑。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你将这张可爱的手作方卡收好，打开了小礼盒的盖子。"]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[11]},{"code":231,"indent":0,"parameters":[16,"兔子胸针~1",0,0,160,56,50,50,0,0]},{"code":232,"indent":0,"parameters":[16,0,0,0,160,56,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["小礼盒内静静躺着一枚兔子胸针。胸针的底座是镀银的，表面则是"]},{"code":401,"indent":0,"parameters":["精准切割出的边缘整齐的布底，布底上用白色与淡金色的丝线绣出"]},{"code":401,"indent":0,"parameters":["一只起跃的兔子模样。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这枚胸针的做工十分精致，有轻微色差的丝线层层叠叠、相互交错，"]},{"code":401,"indent":0,"parameters":["绣出了巧妙的阴影层次，但又不至于让胸针显得厚重，拿在手里重量"]},{"code":401,"indent":0,"parameters":["也很适当。"]},{"code":232,"indent":0,"parameters":[16,0,0,0,160,56,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[16]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["上一个春天，为我们送来了相遇；这一个春天，我们能够因此享受"]},{"code":401,"indent":0,"parameters":["作为彼此朋友的新的一年。虽然今天并非是我们的纪念日之类的……"]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":231,"indent":0,"parameters":[9,"$Hyein平静开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["但是这个季节确实值得我铭记，所以想着和欧尼一起庆祝一下。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["因为在商店看到了这枚胸针，感觉欧尼会喜欢，应该很适合你，于是"]},{"code":401,"indent":0,"parameters":["便买下来了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["不要把它当作是很沉重的礼物哦？心情轻快地收下它，然后继续陪在"]},{"code":401,"indent":0,"parameters":["我身边就好。"]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[9]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁的睫毛垂下来，盯住你的衣角，小心翼翼地说着这些话。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["用心去体会那份小心背后隐藏的细腻心思，你摸索到一份真挚而诚恳"]},{"code":401,"indent":0,"parameters":["的情感。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["让你不禁想要感谢自己能遇见同这个美好的季节一样纤细、和煦，"]},{"code":401,"indent":0,"parameters":["温柔得如同雪化的溪水一样的女孩。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["面对着纯粹的真诚时，人们总会想拿出与之相称的情感回应对方。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["让对方明白，并打从心底信任着“她也是这么想”这件事。"]},{"code":234,"indent":0,"parameters":[7,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["谢谢你…惠仁。"]},{"code":102,"indent":0,"parameters":[["这个礼物对我来说意义非凡，我会一直珍惜它的……","当我看到它的时候，我就会想起你。想起此刻的心情。","这是我们作为朋友的珍贵信物。我会好好爱惜它的。","被你送了这样的礼物…怎么办，我已经担心我会弄丢它了……"],-1,-1,1,0]},{"code":402,"indent":0,"parameters":[0,"这个礼物对我来说意义非凡，我会一直珍惜它的……"],"collapsed":true},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[7]},{"code":231,"indent":1,"parameters":[11,"$Hyein害羞直视~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[11,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["渴望回应的迫切情感催促着自己给惠仁一个拥抱，你把高挑的女孩"]},{"code":401,"indent":1,"parameters":["揽入自己怀中，紧紧抱着她。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["惠仁接受了这个拥抱，将你揽入怀中后轻轻拍了拍你的后背，她因为"]},{"code":401,"indent":1,"parameters":["这个礼物得到了意义深重的评价而感到开心。"]},{"code":232,"indent":1,"parameters":[11,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[11]},{"code":231,"indent":1,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["它能告诉你我们的关系对我来说很重要就好了，很高兴欧尼喜欢这个"]},{"code":401,"indent":1,"parameters":["礼物！"]},{"code":232,"indent":1,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[3]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"当我看到它的时候，我就会想起你。想起此刻的心情。"],"collapsed":true},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[7]},{"code":231,"indent":1,"parameters":[6,"$Hyein惊喜~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[6,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["你十分爱惜这个重要的礼物，反复观摩以至于越看越喜欢。于是把它"]},{"code":401,"indent":1,"parameters":["守在胸口处呵护。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["你回答的话语让惠仁有些害羞，但她似乎很高兴你能这样说。"]},{"code":232,"indent":1,"parameters":[6,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[6]},{"code":231,"indent":1,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["不光是这个礼物，想和欧尼一直做朋友的心情也不会改变哦？"]},{"code":232,"indent":1,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[1]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"这是我们作为朋友的珍贵信物。我会好好爱惜它的。"],"collapsed":true},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[7]},{"code":231,"indent":1,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["轻盈的胸针拿在手中却沉甸甸的，你把它护在手心里，祈望它能永远"]},{"code":401,"indent":1,"parameters":["陪伴在自己身侧。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["你满心欢喜地收下了这份礼物，但惠仁似乎看出你眼底藏着些不易"]},{"code":401,"indent":1,"parameters":["察觉的严肃。"]},{"code":232,"indent":1,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[2]},{"code":231,"indent":1,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["没事的欧尼，这份礼物的意义真的没有那么沉重。我只是想告诉你"]},{"code":401,"indent":1,"parameters":["我的心意…"]},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[7]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[3,"被你送了这样的礼物…怎么办，我已经担心我会弄丢它了……"],"collapsed":true},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["你甚至不敢将这枚精致的胸针拿出来，生怕过于紧张弄掉了它。于是"]},{"code":401,"indent":1,"parameters":["赶紧合起盒子，将它保护在手心中。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["人们在拥有着一些美好时，却总是止不住地去想那种不曾拥有它的"]},{"code":401,"indent":1,"parameters":["可能性或是失去它们的某个未来。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["惠仁也顺着你的情绪，眉头挂上了些许的忧愁。好在那片阴云很快"]},{"code":401,"indent":1,"parameters":["就被她乐观的心态一扫而空。"]},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[7]},{"code":231,"indent":1,"parameters":[4,"$Hyein撒娇~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[4,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["欧尼，不要害怕还未发生的事，先享受当下的喜悦吧？你看，不仅它"]},{"code":401,"indent":1,"parameters":["现在好好的，我们现在也好好的不是吗？"]},{"code":232,"indent":1,"parameters":[4,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[4]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["听了惠仁的话，你回给她一个明媚的笑容。再一次爱护地摩挲了一下"]},{"code":401,"indent":0,"parameters":["礼盒后，把它收进了自己背包的深处。"]},{"code":234,"indent":0,"parameters":[2,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["我能和惠仁成为朋友，真的很幸福。谢谢你当时来问我。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁一时没能明白你这句话的指向，于是你连忙补充道："]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["我们第一次见面时你对我说的那句话。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["“要和我做朋友吗”？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["在春天与惠仁相遇的场景历历在目，你仍然记得并时不时回味起那时"]},{"code":401,"indent":0,"parameters":["的心情。"]},{"code":234,"indent":0,"parameters":[7,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["嗯，所以，惠仁你啊，对我来说真的很重要。我会一直为你的幸福"]},{"code":401,"indent":0,"parameters":["祈祷的。"]},{"code":234,"indent":0,"parameters":[7,[0,0,0,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["微风从花园的另一侧吹拂而来，其中夹杂着梨花微弱的香气。带起从"]},{"code":401,"indent":0,"parameters":["花枝上散落的小片花瓣，被柔风裹挟着飘来，落在你们的发梢与衣服"]},{"code":401,"indent":0,"parameters":["上。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁似乎是被风迷住了眼睛，她睫毛微颤，轻轻眨了眨眼。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她没有立刻接话，而是低头看向你将胸针收进背包的方向。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那一瞬的沉默非常短暂，却如同被拖沓着放慢了一样漫长。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["……为我的幸福祈祷。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她重复了一遍你的话，像是在反复咀嚼其中的意味。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你忽然觉得自己的话语在如此真实的春日里显得非常虚无缥缈——"]},{"code":401,"indent":0,"parameters":["就算你真切地如此希望，这种愿望却无法在此刻给她一个能安然"]},{"code":401,"indent":0,"parameters":["接住她情绪的保障。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这个说法很无力，但搜刮尽脑袋的每一处，你并不清楚还有什么同义"]},{"code":401,"indent":0,"parameters":["的词汇能弥补这种苍白。"]},{"code":234,"indent":0,"parameters":[7,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你停顿了一下，开口补充道："]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["因为惠仁现在就在我身边，我们此刻是幸福的。但我希望这种幸福"]},{"code":401,"indent":0,"parameters":["能延续，我…只能为你祈祷如此宽泛的愿望。"]},{"code":234,"indent":0,"parameters":[7,[0,0,0,0],20,true]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁安静地注视着你的眼睛，把你的话语一字一句地放在心间捧住。"]},{"code":234,"indent":0,"parameters":[2,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["不管是现在还是未来，不管我们的状态与关系如何发展，惠仁这样"]},{"code":401,"indent":0,"parameters":["美好的存在，就配得上幸福二字，即使没有我如此微小的祈祷，你也"]},{"code":401,"indent":0,"parameters":["一定会收获幸福的……"]},{"code":234,"indent":0,"parameters":[2,[0,0,0,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["一阵风又捎过来一朵形状完整的梨花，在两人之间飘飘悠悠地落下，"]},{"code":401,"indent":0,"parameters":["不偏不倚地落在了惠仁放下的饭盒上。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["正好吸引了你们的视线，把两人之间短暂的凝滞抽离。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁忽然笑了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼总是擅长说一些狡猾的话。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的语气终于轻快了起来，听起来如同今日澄澈的天空一样明亮。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["你总是担心我们之间的距离，好像要告诉我：“我们并不如我们"]},{"code":401,"indent":0,"parameters":["认为的那样亲近”、“我们的关系早晚会发生变化”、“我们的世界，"]},{"code":401,"indent":0,"parameters":["早晚会变成你的世界和我的世界”。但你从来没有真正地疏远、离开"]},{"code":401,"indent":0,"parameters":["和冒犯过我。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["说话的同时，她拾起那株掉落在她饭盒上的梨花，把你放在膝上的手"]},{"code":401,"indent":0,"parameters":["翻开，将它放入你的手掌中。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[9,"$Hyein平静开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["多亏如此，我才能从中知晓你对我的感情是如此地真挚。我不讨厌会"]},{"code":401,"indent":0,"parameters":["因此变得纤细敏感的欧尼，不如说，我们真的是一类人。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["一缕头发随着她的动作滑至眼前垂落，她不紧不慢地将它们捋至"]},{"code":401,"indent":0,"parameters":["耳后。"]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[9]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["我也很珍视你。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[10,"$Hyein害羞目移~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["似是为了缓解有些挠人的氛围，她拾起了那只饭勺，轻轻敲了敲盖子"]},{"code":401,"indent":0,"parameters":["发出清脆的声响，再将餐盒打开。"]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[10]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["不过呢——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这次惠仁实打实地挖了一勺自己的便当，依旧是刚才那种“递麦克风”"]},{"code":401,"indent":0,"parameters":["的姿势，把勺子送到你的面前。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["刚才的问题，欧尼还没有给我回答呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的眼睛微微弯起，笑意之下藏着一种不确定的隐晦渴求。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["春天到底为我们送来了什么呢？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你看着她送到自己嘴边的勺子，抿了抿嘴角。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你斟酌着方才全部对话的含义，并试图找出合适的词语概括它们。"]},{"code":234,"indent":0,"parameters":[1,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["……时间。可以一起度过的更多的时间。"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁手中的勺子平稳地悬在你面前。她挑了挑眉，依然没有点头。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她似乎也在做你刚才做过的事——斟酌其中如绒毛般微小的意味。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["几秒钟的沉思后，她轻轻“嗯”了一声。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["相当接近了，不过……"]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["勺子和上面的食物在你面前晃了晃，她给了你非常直观的一种"]},{"code":401,"indent":0,"parameters":["“认可”。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你心神领会地凑了上去，将那一小勺有菜有肉的食物含进嘴里，咀嚼"]},{"code":401,"indent":0,"parameters":["后咽了下去。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["实话实说，味道并不出色，却因为从始至终的过程，变得使人难以"]},{"code":401,"indent":0,"parameters":["忽视地感到记忆深刻。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[9,"$Hyein平静开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["对我来说呢——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["很显然，惠仁此刻在意的也并非是对食物的点评。她只是看着你顺从"]},{"code":401,"indent":0,"parameters":["的动作，继续将话题进行了下去。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["春天会把“还来得及”的事情送过来，让我，让我们拥有某些资格。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你的目光被坦然地陈述着自己观点的惠仁吸引了，你的视线一直被"]},{"code":401,"indent":0,"parameters":["这样的她吸引。"]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[9]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她却没有看你，而是有些漫不经心地用勺子扒拉着餐盒里的配菜。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["像是……还能够再见面。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["还能够再多说一点话。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["还有机会，把想给你的东西交到你手上。"]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":231,"indent":0,"parameters":[10,"$Hyein害羞目移~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["还有可能性，与你分享此刻的我是什么样的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["随着一颗西兰花从食物城堡的顶端掉落，藏在深处的米饭终于重见"]},{"code":401,"indent":0,"parameters":["天日。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁停顿了一下。"]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[10]},{"code":231,"indent":0,"parameters":[11,"$Hyein害羞直视~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["不管是用什么身份。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["最后这句话落在你心头的瞬间，引发出了你心底里无数种思虑，她却"]},{"code":401,"indent":0,"parameters":["把这句话说得异常的平静。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["但比以往的任何一句话都诚恳，近乎千斤的重量。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你忽然才意识到，惠仁在意的，也许并不是恒久不变的未来或特定"]},{"code":401,"indent":0,"parameters":["称呼的改变。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["而是——你们是否有心意，一直停留在彼此能够触及的范围之内。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你立马翻找起自己的背包来，重新将那枚兔子胸针拿了出来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["没有丝毫犹豫，你把它别在了校服衣领处，靠近心口的位置。"]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[11]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["我明白它的含义了——"]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你揪起自己的衣襟，将那枚信物与自己一起展示给惠仁看。"]},{"code":234,"indent":0,"parameters":[7,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["无论什么时候，我们都会记得“现在”的心意。"]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":231,"indent":0,"parameters":[5,"$Hyein惊讶~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[5,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁愣住了，她的目光落在那枚正反射着阳光的兔子胸针上，又缓缓"]},{"code":401,"indent":0,"parameters":["将视线挪至你忽然变得信心满满的脸上。"]},{"code":232,"indent":0,"parameters":[5,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[5]},{"code":231,"indent":0,"parameters":[6,"$Hyein惊喜~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[6,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的表情终于卸下了所有小心翼翼的情绪，变得轻盈而柔和。像是有"]},{"code":401,"indent":0,"parameters":["什么一定会被兑现的承诺在心口轻盈地安置了下来。"]},{"code":232,"indent":0,"parameters":[6,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[6]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["嗯……"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁得到了她想要的答案，她没有再追问，也不再给你什么隐晦的"]},{"code":401,"indent":0,"parameters":["提示并向你确认。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她重新往你的身边靠了靠，把自己的餐盒往更靠近你的位置推了推，"]},{"code":401,"indent":0,"parameters":["又拿起了你的三明治递给你。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["那就，继续野餐吧？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["不然春天送来的时间就要被我们这样一点一点浪费掉了。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你们重新开始了今日的野餐环节。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["阳光缓慢移动，已然挪至你们的正上方，身下两个扁扁的圆影轻轻"]},{"code":401,"indent":0,"parameters":["交叠在一起。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["此刻的空气正浓稠，像未被搅动的蜂蜜在温柔的季节里发酵，作为"]},{"code":401,"indent":0,"parameters":["柔软的温床任由那些感情缓慢地积累。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["仿佛再没有什么能够将那种黏连切断，它的存在与延续越过清晨与"]},{"code":401,"indent":0,"parameters":["黄昏，越过四季的更替。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["春天浓稠而沉甸的气息压在这段近乎永恒的时间里，连未来也显得"]},{"code":401,"indent":0,"parameters":["不必被提及。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["于是某种情感、某种温度、某种信任，被安静地留在了这个午后。"]},{"code":123,"indent":0,"parameters":["D",0]},{"code":242,"indent":0,"parameters":[3]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"D","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,6,0,0,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
