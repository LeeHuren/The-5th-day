{"id":1,"name":"校门与街道的夜","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":230,"indent":0,"parameters":[200]},{"code":241,"indent":0,"parameters":[{"name":"沉默的春","volume":40,"pitch":100,"pan":0}]},{"code":231,"indent":0,"parameters":[15,"梨花校园（夜）背景~1",0,0,0,0,100,100,255,0]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["从教学楼走出来时，天色已经彻底暗了下去，只剩地平线尽头还残留"]},{"code":401,"indent":0,"parameters":["着一线极淡的光。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["校园中喧嚣的声音也在不知不觉中变得稀薄。随着学生的离开，寂寥"]},{"code":401,"indent":0,"parameters":["逐渐替代了活力，在空旷的校园中盘旋。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["此刻的校门口空无一人。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["空气透彻干净，却又带一点空落。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["伴随着一阵电流通过的噼啪声，街边的路灯逐一亮起，把你的视线"]},{"code":401,"indent":0,"parameters":["引导向远处道路的尽头。也许在视线以外的地方，它们也接力着"]},{"code":401,"indent":0,"parameters":["摇曳，似乎从未熄灭。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["暖黄色的灯光落了下来，你们轮廓鲜明的影子被重新勾勒了出来。"]},{"code":401,"indent":0,"parameters":["两道投影的根部在你和惠仁的脚边短暂交缠，又被牵引着向不同"]},{"code":401,"indent":0,"parameters":["方向延伸。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["它们的边缘时不时地碰撞、起伏，仿佛并不担忧自己会受光线的制约"]},{"code":401,"indent":0,"parameters":["而消逝，一前一后、起起伏伏地在彼此的世界中舞动着。"]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你和惠仁并肩走着，步伐并不仓促，想要下意识地把这段路走得更长"]},{"code":401,"indent":0,"parameters":["一点。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["谁都没有刻意打破安宁，空气被某种温和的东西填满了。又因为心情"]},{"code":401,"indent":0,"parameters":["足够轻盈，所以也不会显得尴尬和过于沉默。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["两人的影子在不同的光线下被肆意地重塑形状，时而被拉长，时而"]},{"code":401,"indent":0,"parameters":["团簇在脚边，但一直交叠着。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你能清晰地感知到惠仁的存在。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["在你身侧，距离很近。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["近到根本不需要你抬头凝视、伸手触摸去确认。恰当好处的距离，"]},{"code":401,"indent":0,"parameters":["像一呼一吸间本就存在的间隙。自然得让人不用去担忧怀疑。"]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[15]},{"code":230,"indent":0,"parameters":[10]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["街道逐渐喧嚣起来，视野也逐渐明亮。车站的轮廓一点点浮现。"]},{"code":401,"indent":0,"parameters":["人声汇聚、灯光密集，短暂的安宁将从那一处褪去。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["一段无法言说的柔软时间，走到了需要过渡的地方。"]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁又将脚步放慢了一些，你默许，参考着她的步调调整自己的"]},{"code":401,"indent":0,"parameters":["节奏。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["直到拐进车站旁昏暗的自行车停放区时，热闹与光潮褪去，零散"]},{"code":401,"indent":0,"parameters":["的脚步声被夜色收拢，你们才停下来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这里没有别人，只有一盏在风中悠悠晃动的破旧电灯亮着。飘忽不定"]},{"code":401,"indent":0,"parameters":["的灯影洒在你们身上，晕出一条不太明显的界限。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["一边浸染了暖黄色，一边裹挟着夜色。边缘并不锋利，但提醒着"]},{"code":401,"indent":0,"parameters":["你们，这段同行在这里就要暂时停下。"]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":231,"indent":0,"parameters":[11,"$Hyein害羞直视~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你看到惠仁张了张嘴，却没有吐露出什么言语。只是察觉到你投过来"]},{"code":401,"indent":0,"parameters":["的视线后，习惯性地对你笑了一下。"]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[11]},{"code":231,"indent":0,"parameters":[18,"夜间分别~1",0,0,0,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[18,0,0,0,0,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼，我要在这里上车了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她指了指不远处地铁口的方向，语气自然。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你本以为顺着刚才的情绪，会从这个十分擅长撒娇的孩子的语气中"]},{"code":401,"indent":0,"parameters":["听出些许失落。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["嗯。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你点点头回应，没再开口说些别的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这一瞬的停顿，你自我感觉应该不会显得突兀，反而更像是某种"]},{"code":401,"indent":0,"parameters":["习惯性的留白。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["恰到好处的停歇足够让人意识到——结束，并不是从这一刻开始的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她忽然又叫了你一声。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁的身体靠过来了一点微妙的距离，恰好从光晕中挣脱了出来，"]},{"code":401,"indent":0,"parameters":["越过那条界限，和你一起融进了夜色里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的校服边缘碰到了你的外套下摆，却像是直接用体温去触碰你"]},{"code":401,"indent":0,"parameters":["一样。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你低下去的视线捕捉到她的影子也被拉到你的脚边。分明是两簇"]},{"code":401,"indent":0,"parameters":["影子，却没有被完全分开。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["抬起头，便对上她的眼睛。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["明天见。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她轻轻吐露出简短、柔和而笃定的一句话。用的是你最喜欢的那种"]},{"code":401,"indent":0,"parameters":["声音，那种能够娓娓展露出她的内心与为人是如何美好的语气。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那声音轻到可以一直向上漂浮到世界之外，对你来说却无比鲜亮"]},{"code":401,"indent":0,"parameters":["清晰。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这并不是某种约定，因为摒弃了任何不确定性，所以更像是一种"]},{"code":401,"indent":0,"parameters":["陈述，一种被流动起来的时间串联，自然而然会发生的延续。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁又对你笑了一下。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这个笑容没有冗余的细碎，暗含着不用言说的坦然。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["又带着不会被轻易动摇的，纯粹的明亮。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["嗯……好。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你看着她，意识被轻轻触碰着牵动，呼吸也跟着慢了半拍。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["明天见。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你回应她。这一次，没有任何停顿。你们之间再也不需要任何一点"]},{"code":401,"indent":0,"parameters":["迟疑，于是自然而然地将她的话语接住。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这句回应轻轻顿落在两个人心间，没有止步不前，没有明确的终点，"]},{"code":401,"indent":0,"parameters":["却始终莹亮在某个方位，让人知晓如何继续追寻。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["它会不停息地向后延展，将从过去到未来的一切时间连接起来。"]},{"code":232,"indent":0,"parameters":[18,0,0,0,0,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[18]},{"code":231,"indent":0,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁向后退了两步，回到自己原本的位置。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["随即转身离开。"]},{"code":232,"indent":0,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[7]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她没有再回头看你。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["步伐并不紧凑，甚至有些拖沓。暴露了她也在回味那段同行。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["最开始，人群没能遮住她修长的身形，她只是随着人潮向前移动。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["但她的身影正在被一点点地包裹进人群里去。并非被遮掩，只是像"]},{"code":401,"indent":0,"parameters":["川流不息的溪水一样渡着她远去。高挑的小舟在你的眼中渐渐变小，"]},{"code":401,"indent":0,"parameters":["却始终清晰。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你站在原地看着，直到她一点一点地向下沉去，最终消失在电动扶梯"]},{"code":401,"indent":0,"parameters":["的地平线处。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["溪水带来的并非是断裂的瀑布，更像是轻盈的浪花来回涌跃和扑压，"]},{"code":401,"indent":0,"parameters":["翻腾着汇聚，最终全部安稳地涌进了下一段河道。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["明天见。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你不由自主地又喃喃了一句，想让这句话在自己的心口长久地留存。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["时光在这一刻暂停，被安静地封存，直至两人再次相聚的那一刻。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["空虚从四处侵袭，占据着逐渐变得不知所措的内心。回过神来，自己"]},{"code":401,"indent":0,"parameters":["已抬手覆上胸前的那枚兔子胸针。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["坚硬的金属附着了一层夜晚的凉意，在触碰的一瞬间变得过于清晰。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你却丝毫不介意。那并不是寒冷，反而是一种有些烫手的、被提醒的"]},{"code":401,"indent":0,"parameters":["温度。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你抚摸着、感受着它，没有立刻移开手。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["于是夜色彻底落了下来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["城市的夜晚重新被人群填满，人来人往地嘈杂着，频率极微的震动"]},{"code":401,"indent":0,"parameters":["逐渐在耳际变得清晰，被转化成脚步声、车流声、交谈声的河流，"]},{"code":401,"indent":0,"parameters":["汇聚起来涌入脑海里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你站在其中，却并不觉得自己被淹没。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["正是因为此刻你的胸口安静地留存了足够温暖的事物。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你已确认，她已存在，它们仍在延续。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["因此你没再停留，而是迈开脚步向前走去。脚步轻盈而前所未有地"]},{"code":401,"indent":0,"parameters":["安稳。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那些还未发生的未来，无法再让你感到不安。因为你已经拥有了足够"]},{"code":401,"indent":0,"parameters":["支撑你向前行进的事物。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["夜风从街道的另一侧席卷而来，不再显得冷峭，而是带着柔软缱绻的"]},{"code":401,"indent":0,"parameters":["触感，向自己贴近。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["犹如无声的应许。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["犹如一捧融融月光被盛在心间，柔软白皙，充盈着整个胸腔，让人"]},{"code":401,"indent":0,"parameters":["欢喜。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["如此温暖、如此不张扬，真实地存在于某处。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["连同前方的路也显得不再那么孤单漫长。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["仿佛只要顺从与接纳这种感觉，无论明天会以什么模样到来——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你都能走到她身边，再次回答她。"]},{"code":221,"indent":0,"parameters":[]},{"code":242,"indent":0,"parameters":[3]},{"code":123,"indent":0,"parameters":["D",0]},{"code":121,"indent":0,"parameters":[27,27,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"D","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":201,"indent":0,"parameters":[0,14,0,0,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
