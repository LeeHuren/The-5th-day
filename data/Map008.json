{"id":1,"name":"夕阳下的奔跑","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":230,"indent":0,"parameters":[200]},{"code":241,"indent":0,"parameters":[{"name":"追逐","volume":15,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["天台的门被推开时，一阵夹杂着丝丝春寒的风从室外猛地灌了进来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["冷风钻过人体的缝隙，直击身上布料单薄的地方。虽然没有到难以"]},{"code":401,"indent":0,"parameters":["忍受的地步，但你下意识缩了缩肩膀。"]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["而惠仁却完全不在意。也许是因为她从来都是温暖的体质、又或是"]},{"code":401,"indent":0,"parameters":["因为她总是充满活力，并不介意这些细碎的困扰。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她更先感受到的，是开阔、明亮、惬意和舒爽。被这些吸引着，"]},{"code":401,"indent":0,"parameters":["她站到了天台的正中央。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["然后大大地伸了个懒腰。纤长的双臂高高举起，在空中划了一个完整"]},{"code":401,"indent":0,"parameters":["饱满的半圆后落下。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["像是要把浸透在身体中整整一下午的沉闷都甩出去，尽情释放那些"]},{"code":401,"indent":0,"parameters":["被关在教室里一下午的憋屈。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你站在她身后。她的剪影挡住了你视线中的一部分天空，夕阳的余晖"]},{"code":401,"indent":0,"parameters":["从她的手臂间漏下来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那一瞬间，你也不自觉地放松了下来。虽然没有惠仁那么夸张，"]},{"code":401,"indent":0,"parameters":["但刚刚夹紧的肩头好歹还是松开了一点。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁舒展完身体，满足地呼出一口气。然后把书包和外套一起丢在"]},{"code":401,"indent":0,"parameters":["楼梯口的墙角处。"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼！"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你几乎是下意识地回应她。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["放下！"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁朝你招了招手，你又下意识地照做了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["把肩头的重量卸下来以后，身体又轻了一点点。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["刚直起身子，手腕却被眼前的人影捉去。"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[12,"夕阳下的奔跑~1",0,0,0,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[12,0,0,0,0,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["惠仁？等等！哇啊——"]},{"code":225,"indent":0,"parameters":[5,5,60,true]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["不给你任何反应的余地，惠仁拉着你在宽阔的天空下跑了起来。"]},{"code":225,"indent":0,"parameters":[5,5,60,true]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["两人的脚步在空旷的天台上清晰地回响。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["从耳边呼啸而过的风逐渐强烈，带走了世间细碎、零星、小气的"]},{"code":401,"indent":0,"parameters":["声音。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["啊？！哇——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["方才还是瞬间失去安全感的惊呼，现在已经逐渐变为享受和撒欢的"]},{"code":401,"indent":0,"parameters":["呼喊。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["人类很难在这种自由奔放、毫无顾忌的奔跑中保持冷静。自己的脸上"]},{"code":401,"indent":0,"parameters":["也早已在不知不觉间挂满了笑容。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["情绪被风儿轻盈的尾巴卷起来，托着两颗心向上推。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["我很早——很早！"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她一边跑，一边回头冲你呼喊。声音被切割，散落在春风里，又被"]},{"code":401,"indent":0,"parameters":["重新缝补起来送进你的耳朵里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["就想在天台上这样跑一次试试了！"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁笑得肆意，眼睛亮得像是刚刚紧紧抓住了一直以来打从心底渴求"]},{"code":401,"indent":0,"parameters":["的东西。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那双眼睛留住了太多事物，从清澈的目光中一路流进真挚的心里。"]},{"code":401,"indent":0,"parameters":["那双眼睛也讲述了太多事物，她有没有直接向你陈述，你都一定会"]},{"code":401,"indent":0,"parameters":["听进心坎里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁牵着你的手，你的步伐早已不再被动，而是主动地追随她。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["衣领扬起，轻巧的兔子在被夕阳灼红的云间跃动。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["从被惠仁紧握的手掌间传来的温度很清晰，她完全没有要松开的"]},{"code":401,"indent":0,"parameters":["意思。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你也未曾有过这种想法。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你看着她的侧脸，突然意识到此时此刻也能称之为“幸福”。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你能够为她准备、你通过追随她才能获得的那种幸福。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["……"]},{"code":232,"indent":0,"parameters":[12,0,0,0,0,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[12]},{"code":242,"indent":0,"parameters":[3]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[200]},{"code":241,"indent":0,"parameters":[{"name":"谈心","volume":30,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["视线里已经不知道飘过了多少朵云，从一开始翻卷奔腾的火红色，"]},{"code":401,"indent":0,"parameters":["到逐渐染上天空边界处将近夜色的青灰色。你的气息终于平稳"]},{"code":401,"indent":0,"parameters":["下来了。"]},{"code":231,"indent":0,"parameters":[17,"余晖的坦白~1",0,0,0,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[17,0,0,0,0,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你歪头看向躺在你身边的惠仁，她的呼吸也没有完全平稳，胸口微微"]},{"code":401,"indent":0,"parameters":["地起伏着。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["额前的碎发因为方才的运动略显凌乱，惠仁没有整理它们，她似乎"]},{"code":401,"indent":0,"parameters":["并不介意。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的视线同样追随着那些填满天空的云朵，眼睛微微眯起。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你看着安静的惠仁，从心底涌上了一缕思绪、一种冲动——一种"]},{"code":401,"indent":0,"parameters":["渴望表达的欲望。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["和着些许勇气，你开了口。干燥的空气刚刚刺激过活跃的"]},{"code":401,"indent":0,"parameters":["喉部，让声音听起来像是被粘住了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["……惠仁。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁没有因为你突然的呼唤而看向你，只是用嗓音推出一个音节，"]},{"code":401,"indent":0,"parameters":["应了你一声。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["嗯？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["声音依附着风飘过来，却没有属于它的落点。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你原本准备好的话，却在这一刻忽然变得有些生涩，你不得不停顿"]},{"code":401,"indent":0,"parameters":["了几秒。惠仁却依然保持原样，没有任何催促，像是知道你会自己"]},{"code":401,"indent":0,"parameters":["继续说下去。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["我不喜欢把一些东西说得太明确。因为——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你深吸了一口气，把视线重新落回天空上。那些被夕阳浸软的暮色"]},{"code":401,"indent":0,"parameters":["发酵得足够深沉，好像能安稳接住一些平日无法安放的话语。你又"]},{"code":401,"indent":0,"parameters":["因此得到了些许勇气。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["我不擅长面对任何会改变的东西，总是担心有些话一旦说出口，"]},{"code":401,"indent":0,"parameters":["改变也会随之而来......"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["但是，无论是什么事，都终究会发生改变，我只是……不知道该怎样"]},{"code":401,"indent":0,"parameters":["面对那些变化。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["风在两人的呼吸间缓慢地流动，你无法识别其中糅杂的情绪。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁依旧没有回应，你无所适从地蜷了下自己的手指，却无意间勾到"]},{"code":401,"indent":0,"parameters":["了惠仁的袖口。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["就像落叶经过漫长的荡漾才触碰到水面的力道，很轻，却足够泛起"]},{"code":401,"indent":0,"parameters":["涟漪使人察觉。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你能感觉到惠仁整个人轻微地颤动了一下。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这样慢节奏、不着重点的解释对别人来说一定是一种折磨。你咬了咬"]},{"code":401,"indent":0,"parameters":["嘴唇，心里不禁埋怨起自己。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["不过指尖传来的那一点点细微的触感及其温度，让你堵在心头的话语"]},{"code":401,"indent":0,"parameters":["变得更清脆了些。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["距离、心意、关系、定义……"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这些被你追寻了许久意义的词语被你一个个释放出来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["此刻却不像是解释，而是要把它们从心口挪开。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["——所有事情都会随着时间而改变。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["对于结论的陈述似乎比想象中地更加安宁、更加能够接受。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["终于来到真正将心意展示给她的步骤时，遮蔽在心间的朦胧一下子"]},{"code":401,"indent":0,"parameters":["消散，之后反而变得流畅起来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["可唯独“想要陪在你身边”这件事。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["天边的光芒逐渐黯沉下去，你心中的视野却前所未有地明朗。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那些原本模糊、游离、不愿触碰的念头被从晃荡的心海中捞了起来，"]},{"code":401,"indent":0,"parameters":["在胸口处微微发烫。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你继续用缓慢安稳的声音诉说着心意，惠仁的呼吸随着你的陈情轻了"]},{"code":401,"indent":0,"parameters":["一下。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["我好像是有把握的，不管是过去还是未来，从一开始到以后——"]},{"code":232,"indent":0,"parameters":[17,0,0,0,0,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[17]},{"code":231,"indent":0,"parameters":[10,"$Hyein害羞目移~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["话语落下，空气没有立刻震颤并送来回应。"]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[10]},{"code":231,"indent":0,"parameters":[11,"$Hyein害羞直视~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["耳边传来布料间极其轻微的摩擦声和侧过来的气息，你通过余光捕捉"]},{"code":401,"indent":0,"parameters":["到惠仁终于看向了你。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你很肯定在这种气氛下，直视夕阳最后挣扎着燃烧的光晕似乎比与"]},{"code":401,"indent":0,"parameters":["惠仁对上目光更温和一些。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你脑海中清晰地倒映着惠仁是如何注视你的，那种视线会打乱自己的"]},{"code":401,"indent":0,"parameters":["心跳、自己的呼吸、自己的思维，自己的一切节奏。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你没能立刻听到惠仁的回应，留给你的是短暂的沉默。"]},{"code":232,"indent":0,"parameters":[11,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[11]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["然后你听到了一声轻笑。那轻灵的声音贴合着你的心口滑动，让紧绷"]},{"code":401,"indent":0,"parameters":["的身体与精神缓慢地放松。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["我……相信欧尼。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的声音柔软，却包含了对一些事情近乎执念的坚定，融化在风里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的笃定并不张扬，更像是长久以来慢慢积攒的执念，在这一刻通过"]},{"code":401,"indent":0,"parameters":["那双真诚的眼睛安静地流露出来。"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼说着那些关于我的话的时候，表情总是会变得……很不一样。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁的话语落在你心间，似乎能够揭穿那里的温度一般。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼总是有些紧张，但我能感觉到——感觉到你的心意是多么坚定。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她用目光描摹着你，似乎在使她脑海深处的模样与此刻眼前的你"]},{"code":401,"indent":0,"parameters":["重叠。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[9,"$Hyein平静开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["我从一开始就知道，欧尼绝对不是会敷衍对待感情的人，你说出的"]},{"code":401,"indent":0,"parameters":["每一句话，你都会做到。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这句话不像是评价，更像结论。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她顿了顿，眼神躲避了一下，又很快落回你眼中。"]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[9]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["也不是……对谁都会这样的人。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你察觉到那一丝宝贵的在意，正在她的心里占据着某个位置。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁又忽地笑了，轻笑声贴着风，柔软得使人感到一丝醉意。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["所以我才会相信，已经存在的，和还未存在的事，我都相信。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她侧过脸，睫毛在余晖的纯净暖色中微微颤动。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["明明惠仁没有做任何靠近的动作，你却觉得你们之间的距离更近了"]},{"code":401,"indent":0,"parameters":["一些，那道如星辰般灼耀着恒定微光的眼眸近在咫尺。"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["因为是欧尼给我的保证。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["并非是某件事值得她全心全意地信任，而是说这句话的人，让她愿意"]},{"code":401,"indent":0,"parameters":["相信。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼是怎么想我的，我一直都知道。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["没有丝毫的迟疑，她的话语落进风里，没有被吹散，反而更清晰"]},{"code":401,"indent":0,"parameters":["了些。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁重新躺好，她的视线落回天空。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她慢慢呼出一口气，胸腔缓慢地下沉。像是把刚才那一刻完好地烙进"]},{"code":401,"indent":0,"parameters":["心里，妥善安放起来。"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[9,"$Hyein平静开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["如果真的有一天，事情会改变的话——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她又开口，语气比刚才更轻盈。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["紧随其后的又是陷入思索的停顿。你知道，她在想象那种“如果”。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["或许是距离，或许是改变，或许是你们都不愿意细想的那一类结局。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["但下一秒，惠仁的嘴角还是扬起了一如往常的笑意。"]},{"code":232,"indent":0,"parameters":[9,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[9]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["那就由我来再问一次欧尼就好了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你因为这个答复而微微一愣。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她撑起手肘凑到你身边，你的视线里出现她的脸庞，发丝与心意在"]},{"code":401,"indent":0,"parameters":["两人间晃荡。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那目光直直地落进你眼底，没有丝毫的回避，清晰地让人无处躲藏。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["声音很近，在你的思绪中回荡。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["要和我做朋友吗？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["像是在复述过去，同时给未来留下了一个实实在在的入口，你可以"]},{"code":401,"indent":0,"parameters":["通过它去往任何有她在的未来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这句话曾经、或是即将落在你心头无数次，它不代表任何答案，"]},{"code":401,"indent":0,"parameters":["却给你提供了无数次的机会和可能。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这种近乎宠溺的无条件信任过于珍贵，对你们彼此来说都是。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["无论如何，你们总会有一个重新开始的起点和永远不会被终止的"]},{"code":401,"indent":0,"parameters":["约定。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["需要做的事简单又显而易见——只有一次又一次地走向彼此。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你想起最初的那个时刻，想起一切是如何开始、你最初拥有那种心意"]},{"code":401,"indent":0,"parameters":["时的心情，那种悸动从未褪色。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你想起自己是如何回应她的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["呼吸轻轻收紧，又慢慢放开——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["风带走了最后一点属于白昼的温度，你却感到某种恒定的温暖，"]},{"code":401,"indent":0,"parameters":["正一点点贴近心口。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["于是再一次回应她——"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":242,"indent":0,"parameters":[3]},{"code":123,"indent":0,"parameters":["B",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"B","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,9,0,0,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
