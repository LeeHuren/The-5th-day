{"id":1,"name":"进入花园","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":203,"indent":0,"parameters":[1,0,1,3,0]},{"code":211,"indent":0,"parameters":[1]},{"code":230,"indent":0,"parameters":[200]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["和煦的太阳正当空，驱散了清晨时附着在天空上的寡淡冷色。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["阳光浸透了蕴藏勃勃生机的每寸土地，柔嫩的颜色点缀在于冬日时"]},{"code":401,"indent":0,"parameters":["曾是一片冷寂模样的学校花园里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["两侧绿化带里的青草已经重新发芽，被漫长寒冬冻伤的部分草皮也"]},{"code":401,"indent":0,"parameters":["已经被重新填补。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["嫩芽的新绿和小块的油绿相互交织，使柔软草皮的色彩十分有层次，"]},{"code":401,"indent":0,"parameters":["看起来就像大地重新开始呼吸了一般。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["校工似乎为了赶上春天的脚步，把校园里大部分地方都检查翻修了"]},{"code":401,"indent":0,"parameters":["一番。中庭的喷泉在前几日也完成了重新运行前的检修，近日重新"]},{"code":401,"indent":0,"parameters":["涌出了清冽的水色。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["涌动的淡青波纹间，几粒暖白被水流推至边缘，在大理石制的台壁"]},{"code":401,"indent":0,"parameters":["边缘旁起起伏伏。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那是梨花的花瓣，是被篆刻在校徽中的校花。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["几颗形态高大的梨树臂展繁茂，为几代女子撑起了能够安心学习的"]},{"code":401,"indent":0,"parameters":["一方天地。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["成片的云白色梨花缀在蓝灰色的枝桠上，它们从来不会将能够"]},{"code":401,"indent":0,"parameters":["仰望青天的缝隙堵死，而更愿意在天气严酷时，为学生们遮蔽"]},{"code":401,"indent":0,"parameters":["盛暑与风雨。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["尽管你们每天都会来到学校花园，这里的植物却会经过一夜的悄然"]},{"code":401,"indent":0,"parameters":["生长，在白昼时分为你们重新呈现出让人惊叹的崭新样貌。"]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁显然已经被浓郁春色和被阳光焙得正好的室外温度深深吸引，"]},{"code":401,"indent":0,"parameters":["挽住你的胳膊轻轻拽了拽，迫不及待地想要找一块舒适的区域尽情"]},{"code":401,"indent":0,"parameters":["享受自然和午餐。"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":121,"indent":0,"parameters":[3,3,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":1,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":3,"switch1Valid":true,"switch2Id":4,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":1,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":2,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":1,"y":3},
