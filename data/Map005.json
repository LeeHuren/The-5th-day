{"id":6,"name":"梨花树","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":677,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"盛开的梨花树"]},{"code":401,"indent":0,"parameters":["你来到庭院中最繁茂的梨树的壮硕树干下，抚上有些许润意的树皮，"]},{"code":401,"indent":0,"parameters":["似乎能直接从坚质的表皮中感到生命的脉络。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"盛开的梨花树"]},{"code":401,"indent":0,"parameters":["梨花的香气无时不刻地萦绕在鼻尖，使人心情舒畅。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"盛开的梨花树"]},{"code":401,"indent":0,"parameters":["洁白的花瓣雨伴着微风吹拂树叶所形成的光斑散落，前者触手可及，"]},{"code":401,"indent":0,"parameters":["后者却虚幻不定。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"盛开的梨花树"]},{"code":401,"indent":0,"parameters":["这里似乎是最能感受春意、也足够浪漫的位置，不过面朝着阳光有些"]},{"code":401,"indent":0,"parameters":["刺眼。"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":13,"y":4},
{"id":7,"name":"喷泉前的座椅","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":580,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"水汽氤氲的喷泉"]},{"code":401,"indent":0,"parameters":["你来到花园中庭的喷泉前，围绕着喷泉放置的几个座椅上有些许"]},{"code":401,"indent":0,"parameters":["水汽。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"水汽氤氲的喷泉"]},{"code":401,"indent":0,"parameters":["水柱从喷泉中央涌出、分流而下，被引力拉扯着摔落在蓄水池的"]},{"code":401,"indent":0,"parameters":["水面，惹起一圈圈波澜。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"水汽氤氲的喷泉"]},{"code":401,"indent":0,"parameters":["淅淅沥沥的水流声不绝于耳，因为足够清脆动听，倒也算不上吵闹。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"水汽氤氲的喷泉"]},{"code":401,"indent":0,"parameters":["这里似乎让人感到充满活力，但是总有小水珠落在自己的身上。"]},{"code":401,"indent":0,"parameters":["或许，还会落入饭里。"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":4,"y":8},
