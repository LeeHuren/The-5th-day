{"id":1,"name":"放学前","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":230,"indent":0,"parameters":[200]},{"code":241,"indent":0,"parameters":[{"name":"游离","volume":60,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["下午的课程，在丝丝困意的侵袭和低迷的氛围中进行着。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["太阳从正中央滑至窗户的另一侧，把讲台上老师的影子从清晰拉长到"]},{"code":401,"indent":0,"parameters":["逐渐模糊。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["愈是接近放学的时间，学生们愈是难以集中精神识别老师口中正滔滔"]},{"code":401,"indent":0,"parameters":["不绝的话语的含义。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["粉笔划过黑板的声音断断续续，结尾总是伴随着用力顿点的闷响。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你的注意力也伴着越发模糊的视线逐渐偏离，你低下头用拇指和食指"]},{"code":401,"indent":0,"parameters":["去掐揉自己的太阳穴，试图缓解这种大脑缺氧的晕厥感。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["手掌放下时，手指无意间触碰到衣襟上冰凉的胸针，害得你心中一个"]},{"code":401,"indent":0,"parameters":["机灵。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你低头看向惠仁送给你的胸针，那只正跃起的兔子，被夕阳的光辉"]},{"code":401,"indent":0,"parameters":["直射，金属质感的白光有些刺眼。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你恍惚觉得它像是随时要从衣料上一跃而下。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你又回想起中午发生的事情，回味和琢磨起惠仁向你说的那些话。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你想得入神，只能反复在脑海中组织着语言，重复地、改变着方式地"]},{"code":401,"indent":0,"parameters":["回答她，然后臆想她的反应，她的回应，她的模样。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁的座位被安排在教室后排的位置，因此此刻她的身影并不存在于"]},{"code":401,"indent":0,"parameters":["你的视线中。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你突然有一种强制被要求延迟满足的不满与愤慨。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那种烦躁的感觉拖着你昏昏沉沉的脑袋和四肢。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["下坠，下坠。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["下坠的同时在耳边发出聒噪的嗡鸣。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["……"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["下坠到某个高度时，四周终于爆发出了一些高振频的声音洗涤了你"]},{"code":401,"indent":0,"parameters":["朦胧的心思。"]},{"code":242,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["不知是谁——总之你一定要感谢她，打开了前排的窗户，凉爽的微风"]},{"code":401,"indent":0,"parameters":["将沁人心脾的新鲜空气送了进来，轻轻拂过被教室闷透的每个人的"]},{"code":401,"indent":0,"parameters":["鼻尖。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["放学的铃声解放了一颗颗自由的心。"]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":