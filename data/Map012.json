{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":231,"indent":0,"parameters":[2,"$Hyein平静微笑~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁收拾好了东西坐在自己的座位上，正特意等着你。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["在教室的后方，那里的学生都已经陆续离开了。而惠仁既没有看"]},{"code":401,"indent":0,"parameters":["手机，也没有参与其他同学间的闲聊，只是安静地坐在那里，所以"]},{"code":401,"indent":0,"parameters":["显得格外显眼。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你们平常会一起走一段回家路，这样的等待并不稀奇。但你能从氛围"]},{"code":401,"indent":0,"parameters":["里辨别出，她似乎还有什么话想与你说。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["出于一种确认的目的，你先开了口——"]},{"code":234,"indent":0,"parameters":[2,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["今天舞蹈社没有活动吗？"]},{"code":232,"indent":0,"parameters":[2,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[2]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁笑了笑，似乎是在为难得的可以自由支配的放学时间感到开心。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["今天舞蹈社学姐们的年级有课外活动，所以要暂停一次活动。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她说得很随意，却能额外听出一点轻快。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你点了点头。几位学姐你都认识，因为你经常等惠仁一起放学，所以"]},{"code":401,"indent":0,"parameters":["多少都混了个眼熟。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["舞蹈社的学姐都比惠仁年长，今年的新生似乎只有惠仁和同班的希瑟"]},{"code":401,"indent":0,"parameters":["，怪不得刚才她也回家了。"]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[3]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["——所以，天台今天应该也空出来了。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["我们上去坐坐吧？"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":231,"indent":0,"parameters":[6,"$Hyein惊喜~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[6,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁说得很自然，好似知道你会同意一样，像是早已经共同决定好的"]},{"code":401,"indent":0,"parameters":["行程。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她站起身，把单肩书包利落地甩到肩上，另一只手抱起自己的校服"]},{"code":401,"indent":0,"parameters":["外套。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["动作干净、轻盈，她总是这样，好像很少会在该做什么、该怎么做"]},{"code":401,"indent":0,"parameters":["这件事情上犹豫，让人感到清爽。"]},{"code":232,"indent":0,"parameters":[6,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[6]},{"code":231,"indent":0,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她向你伸出手。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["……"]},{"code":232,"indent":0,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[1]},{"code":123,"indent":0,"parameters":["A",0]},{"code":242,"indent":0,"parameters":[3]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,8,0,0,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
