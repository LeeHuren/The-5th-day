{"id":3,"name":"值日生","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":13,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["身材矮小的值日生正在擦着黑板，她拼尽全力也只能勉勉强强擦掉"]},{"code":401,"indent":0,"parameters":["大半部分板书。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你知道今天负责值日的小组分明就有个子更高的同学，只是环顾了"]},{"code":401,"indent":0,"parameters":["一周后却不见她的踪影。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你拍了拍拼尽全力挥舞着手臂的小个子女生，询问她为什么不等其她"]},{"code":401,"indent":0,"parameters":["人回来，让她们完成这个工作。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["女生终于停止了跳跃，又不甘心地抹了抹自己能够到的最极限的"]},{"code":401,"indent":0,"parameters":["高度，同时因疲倦而气喘吁吁的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"身材矮小的值日生"]},{"code":401,"indent":0,"parameters":["平常确实都是由她们来做没错，我反而很少能擦黑板。擦黑板和画画"]},{"code":401,"indent":0,"parameters":["一样，不觉得很有趣吗？而且，还很解压。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["女生和你说话的同时，把黑板上的粉笔沫用板擦拖拽着涂均，白色的"]},{"code":401,"indent":0,"parameters":["痕迹最终形成了几朵小花的形状。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你点点头表示理解，有些轻松的工作完成起来确实能让人得到满足感"]},{"code":401,"indent":0,"parameters":["与成就感。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["即使完成的并不完美，但享受的过程确实是更重要的。"]},{"code":123,"indent":0,"parameters":["B",0]},{"code":121,"indent":0,"parameters":[23,23,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":fa