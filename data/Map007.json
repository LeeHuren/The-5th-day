{"id":6,"name":"同学5","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":158,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["关系不错的朋友已经收拾整齐，此时正要从教室门离开，看到你又"]},{"code":401,"indent":0,"parameters":["停下了脚步。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她的目光很快被你领口处的一抹光芒吸引住，仔细端详了一会儿那枚"]},{"code":401,"indent":0,"parameters":["胸针后，先是惊奇地夸赞了一番，又继续问起关于它的事。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"潘希瑟"]},{"code":401,"indent":0,"parameters":["诶，这个！"]},{"code":231,"indent":0,"parameters":[16,"兔子胸针~1",0,0,160,56,50,50,0,0]},{"code":232,"indent":0,"parameters":[16,0,0,0,160,56,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"潘希瑟"]},{"code":401,"indent":0,"parameters":["好漂亮的胸针！也太适合你了吧！早上的时候还没有呢，什么时候"]},{"code":401,"indent":0,"parameters":["戴上的？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你忽地为要介绍这份礼物感到有些害羞，于是下意识地摸了摸自己"]},{"code":401,"indent":0,"parameters":["胸口正勾起对方好奇心的物品。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["布面细密的纹理在指腹下的感受很是清晰，你不禁也顺着她的视线将"]},{"code":401,"indent":0,"parameters":["目光投了过去。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["那只跃起的兔子被绣得很有精神，白色的丝线干净利落，淡金色的"]},{"code":401,"indent":0,"parameters":["部分在光线下微微隆起，通过近乎完美的颜色搭配与光影交错，"]},{"code":401,"indent":0,"parameters":["做出了类似浮雕的效果。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你的思绪在一瞬间顿住，因为你突然意识到：这样精美的礼物，不像"]},{"code":401,"indent":0,"parameters":["是随手挑到，又随手买下的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这个念头突兀地出现，让你感到了些许不自在……"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["午休的时候，惠仁送给我的礼物。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你的语气有些回避，似乎是不太习惯承认这件事，并把这件事宣之"]},{"code":401,"indent":0,"parameters":["于口。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"潘希瑟"]},{"code":401,"indent":0,"parameters":["哦——"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["尾音刻意地被拖了很长很长，她瞥了你一眼，随后目光继续锁定住"]},{"code":401,"indent":0,"parameters":["那枚胸针。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"潘希瑟"]},{"code":401,"indent":0,"parameters":["这么精细的做工，这么独特的礼物……应该下功夫挑了很久吧？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["非常自然而然飘出的评价却重重击打了你的心，把某些关于惠仁准备"]},{"code":401,"indent":0,"parameters":["这份礼物时，你未曾细想过的细节都带了出来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你一时没能接上她的话，这种反应更是一种沉默的承认。"]},{"code":232,"indent":0,"parameters":[16,0,0,0,160,56,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[16]},{"code":101,"indent":0,"parameters":["",0,0,2,"潘希瑟"]},{"code":401,"indent":0,"parameters":["这枚胸针和你的气质很契合，别在你身上刚刚好。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["同伴见你为了回答而为难，调整了语气使氛围变得轻快了点。她把"]},{"code":401,"indent":0,"parameters":["视线从那枚特别的礼物上收了回去，随后拍了拍你的肩膀。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"潘希瑟"]},{"code":401,"indent":0,"parameters":["惠仁很会为你挑礼物嘛。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她说完这句话，想起些什么事情，嘴角勾了勾，又补了一句——"]},{"code":101,"indent":0,"parameters":["",0,0,2,"潘希瑟"]},{"code":401,"indent":0,"parameters":["她很清楚你会喜欢什么。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你忽然想起中午惠仁把盒子递到你手里时的样子。还有那句"]},{"code":401,"indent":0,"parameters":["“不要把它当作很沉重的礼物”。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你才意识到这种做法暗涵的意义已经变得清晰可见。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["……嗯。谢谢。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["与她道谢后，她挥挥手向你道别。"]},{"code":123,"indent":0,"parameters":["A",0]},{"code":121,"indent":0,"parameters":[26,26,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":4,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":8,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":158,"characterName":"","characterIndex":0,"direction":2,"pattern":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她向教室外走去。"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":14,"y":3},
