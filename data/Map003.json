{"id":1,"name":"晨读前的教室","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":230,"indent":0,"parameters":[200]},{"code":222,"indent":0,"parameters":[]},{"code":241,"indent":0,"parameters":[{"name":"光明","volume":25,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["早餐为学生们补充了足够的气力，具体表现在第一节课前的教室实在"]},{"code":401,"indent":0,"parameters":["是热闹到有些嘈杂。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["与惠仁的闲聊不间断地从早餐持续到现在，从昨日回家后发生的日常"]},{"code":401,"indent":0,"parameters":["到谈论宏大梦想与未来，从校园生活中发生的琐碎小事到遥远的世界"]},{"code":401,"indent":0,"parameters":["另一端发生着的故事。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这个世界上总是有太多可以与她谈论的东西。"]},{"code":231,"indent":0,"parameters":[13,"课间杂谈~1",0,0,0,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[13,0,0,0,0,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁的座位在距离你有些远的位置，此刻正因为取得了同意而占据了"]},{"code":401,"indent":0,"parameters":["你前桌的位置。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她坐在椅子上侧着身子方便与你交谈，柔顺的乌发搭在肩头，再在"]},{"code":401,"indent":0,"parameters":["胸口处垂泻成好看的弧度。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["随着谈话的兴致越发高昂，饱满的脸颊肉微微鼓起，这让你不禁想起"]},{"code":401,"indent":0,"parameters":["在刚入学的时候，包括你在内的同班同学几乎都不敢靠近她。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["当惠仁脸上没有笑意时，本就凌厉的眉眼弧度更加蒙上一层震慑感。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["不过她当然没有在日后的校园生活里贯彻那样令人望而却步的形象。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["事实上——她很难贯彻，因为那种形象本身就只是她最肆意张扬的"]},{"code":401,"indent":0,"parameters":["一小部分。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["至于剩余的那部分要复杂得多，自己也是在长久的相处里才得以发现"]},{"code":401,"indent":0,"parameters":["和了解那些惹人喜爱之处。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你为知晓有这样的人的存在而感到慰籍，为在诺大的世界中与她建立"]},{"code":401,"indent":0,"parameters":["了微小却亲密的关系而感到自豪。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["思绪至此，惠仁早已注意到你眼底的笑意。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["两人之间的氛围和默契似乎无法用具象的言语形容出来，但这种对"]},{"code":401,"indent":0,"parameters":["彼此的感觉是心照不宣的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["通过你的神情，她已经清楚地了解在你看来，你们的相处对彼此来说"]},{"code":401,"indent":0,"parameters":["是多么愉快并让人放松。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她正谈起的话题戛然止住，因为此时此刻有更令她感兴趣的事。"]},{"code":232,"indent":0,"parameters":[13,0,0,0,0,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[13]},{"code":231,"indent":0,"parameters":[3,"$Hyein喜悦~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[3,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["欧尼，为什么看起来这么开心？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["瞧她俏皮的语气，她在明知故问。"]},{"code":234,"indent":0,"parameters":[3,[-50,-50,-50,0],20,true]},{"code":102,"indent":0,"parameters":[["因为…这样的时间对我来说真的很珍贵。","…我不希望这样的日子会有迎来结束的那一天。","惠仁，我们会一直是朋友吗？","因为这些微小的事而感到开心是件很奇妙的事…"],-1,-1,1,0]},{"code":402,"indent":0,"parameters":[0,"因为…这样的时间对我来说真的很珍贵。"]},{"code":232,"indent":1,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[3]},{"code":231,"indent":1,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["惠仁因为你直白的表达停滞了一瞬，随即投来的目光便柔软了下来。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["她难得地腼腆了起来，于是浅浅的梨涡便露了出来。"]},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[7]},{"code":231,"indent":1,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["当然，对我来说也是。"]},{"code":232,"indent":1,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[1]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"…我不希望这样的日子会有迎来结束的那一天。"]},{"code":232,"indent":1,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[3]},{"code":231,"indent":1,"parameters":[7,"$Hyein真挚开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["惠仁敏锐地察觉到你内心深处的丝缕苦楚，没经思索就覆住了你的"]},{"code":401,"indent":1,"parameters":["手。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["在感到不安的时候，肢体接触与专注的注视是最能够给予人安全感的"]},{"code":401,"indent":1,"parameters":["行为。惠仁下意识地想让你能感到安心。"]},{"code":232,"indent":1,"parameters":[7,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[7]},{"code":231,"indent":1,"parameters":[1,"$Hyein喜悦闭目~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[1,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["欧尼，可是我们现在正一起尽力享受这些呢。"]},{"code":232,"indent":1,"parameters":[1,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[1]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[2,"惠仁，我们会一直是朋友吗？"]},{"code":232,"indent":1,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[3]},{"code":231,"indent":1,"parameters":[8,"$Hyein略有所思~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[8,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["惠仁的目光移向远处，但你知道那眼神的含义并不是怨怼与不满，"]},{"code":401,"indent":1,"parameters":["她只是认真地思忖着你的话语。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["她一直都会给你深思熟虑过的、只属于她的回答。思考了一瞬后，"]},{"code":401,"indent":1,"parameters":["她开口。"]},{"code":232,"indent":1,"parameters":[8,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[8]},{"code":231,"indent":1,"parameters":[6,"$Hyein惊喜~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[6,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["无论未来如何改变，都不会影响我此刻是如此愿意的。"]},{"code":232,"indent":1,"parameters":[6,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[6]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[3,"因为这些微小的事而感到开心是件很奇妙的事…"]},{"code":232,"indent":1,"parameters":[3,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[3]},{"code":231,"indent":1,"parameters":[8,"$Hyein略有所思~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[8,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["惠仁因为你的回答歪了歪头，似乎在琢磨你这句话表面和内在的全部"]},{"code":401,"indent":1,"parameters":["含义。"]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["短暂的停顿后，她的脸上又恢复方才的笑容。似乎是为了表达理解"]},{"code":401,"indent":1,"parameters":["你的情绪，她耸了耸肩。"]},{"code":232,"indent":1,"parameters":[8,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[8]},{"code":231,"indent":1,"parameters":[9,"$Hyein平静开口~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":1,"parameters":[9,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":1,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":1,"parameters":["正是这些微小的幸福才构成了我们的生命嘛。"]},{"code":232,"indent":1,"parameters":[9,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":1,"parameters":[9]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[10,"$Hyein害羞目移~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["说完这句话，惠仁直视着你眼底的眸子泛起些许羞意，她连忙把"]},{"code":401,"indent":0,"parameters":["注意力拐到你身上，于是隔着课桌拍了拍你的侧臂。"]},{"code":232,"indent":0,"parameters":[10,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[10]},{"code":231,"indent":0,"parameters":[6,"$Hyein惊喜~1",0,0,158,0,50,50,0,0]},{"code":232,"indent":0,"parameters":[6,0,0,0,158,0,50,50,255,0,60,true,0]},{"code":101,"indent":0,"parameters":["",0,0,2,"李惠仁"]},{"code":401,"indent":0,"parameters":["我明白，高中生的清晨会多愁善感嘛！"]},{"code":234,"indent":0,"parameters":[6,[-50,-50,-50,0],20,true]},{"code":101,"indent":0,"parameters":["",0,0,2,"兔子"]},{"code":401,"indent":0,"parameters":["而心思比我更细腻的惠仁则是多愁善感24小时营业……"]},{"code":232,"indent":0,"parameters":[6,0,0,0,158,0,50,50,0,0,60,true,0]},{"code":235,"indent":0,"parameters":[6]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["任课老师在这时走进了教室，放声畅谈的声音立马转变成了低沉的"]},{"code":401,"indent":0,"parameters":["嗡鸣。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["惠仁起身，以勾起的嘴角佐以抛向你的媚眼结束了今日的晨聊，起身"]},{"code":401,"indent":0,"parameters":["回到自己的座位去了。"]},{"code":101,"indent":0,"pa