{"id":1,"name":"午休","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":230,"indent":0,"parameters":[200]},{"code":241,"indent":0,"parameters":[{"name":"沉默的春","volume":35,"pitch":100,"pan":0}]},{"code":222,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[5]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["午休铃声的响起宣告着半日课程的结束。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["几个饿狠了的学生们迫不及待地从座位上弹起，有些则是刚从睡梦中"]},{"code":401,"indent":0,"parameters":["苏醒。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你的目光跨过终于松懈下来的人群，瞥见惠仁正慢条斯理地收拾着"]},{"code":401,"indent":0,"parameters":["自己的桌面。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["她把教科书与笔记堆叠起来，立起，再磕整齐。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["教科书上包着满是草莓纹样的透明书皮——是某次放学你陪她一起"]},{"code":401,"indent":0,"parameters":["去买的。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["然后把有着各种使人心情愉悦的颜色的文具收进自己的笔袋里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["下午还会用到的东西整齐摆放进桌斗里，下午用不到的，则收进"]},{"code":401,"indent":0,"parameters":["书包里。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["最后从书包里拿出被平整餐布打包起来的饭盒，向你走了过来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["通常，你们每天都会各自从家里带饭来。因为你们喜欢在学校花园的"]},{"code":401,"indent":0,"parameters":["各处“野餐”。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这个习惯持续了过去的一整个学年。偶尔心血来潮的时候，两人会"]},{"code":401,"indent":0,"parameters":["相互打过招呼再一起去食堂解决午饭。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["但因为是春天，惠仁会格外期待每天的野餐时间。所以最近两周，"]},{"code":401,"indent":0,"parameters":["每天中午都是“野餐”而非“堂食”。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["你从书包拿出早上在便利店买的三明治和零食，以及野餐必备的"]},{"code":401,"indent":0,"parameters":["餐垫。"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["这些都备齐了，再加上能一起与你享受的朋友，才算得上完美的"]},{"code":401,"indent":0,"parameters":["春日野餐。"]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":221,"indent":0,"parameters":[]},{"code":201,"indent":0,"parameters":[0,5,1,3,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
